{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "identifier": "com.system.knowledgebot",

  "build": {
    "beforeDevCommand": "npm --prefix system-ui run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix system-ui run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../system-ui/dist"
  },

  "app": {
    "windows": [
      {
        "title": "System Knowledge Bot",
        "width": 900,
        "height": 600,
        "resizable": false
      }
    ],

    "security": {
      "csp": null
    }
  }
}
