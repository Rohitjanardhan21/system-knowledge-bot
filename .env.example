# Copy to .env and provide unique secrets before starting Docker Compose.
ENV=production
CVIS_HTTP_PORT=80
CVIS_API_KEY=
JWT_SECRET=
CVIS_ADMIN_USER=admin
CVIS_ADMIN_PASS=
GRAFANA_PASS=

# Hosted personal accounts require PostgreSQL, a public HTTPS origin, and SMTP.
CVIS_DATABASE_URL=
PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Leave blank to disable cross-origin browser access.
ALLOWED_ORIGIN=

# Optional local Ollama model name for on-host, opt-in diagnostic reasoning.
# Leave blank to use rules and parsers only.
CVIS_LOCAL_LLM_MODEL=
